+def _index_select_nested_tensor_rows(tensor: torch.Tensor, indices: list[int]) -> torch.Tensor:
+    """Select rows from a jagged tensor without relying on a buggy unbind path."""
+    indices = [int(index) for index in indices]
+    ragged_idx = getattr(tensor, "_ragged_idx", tensor.dim() - 1)
+    try:
+        tensor_list = tensor.unbind()
+    except RuntimeError:
+        values = tensor.values()
+        offsets = tensor.offsets()
+        candidate_dim = ragged_idx - 1
+        if not 0 <= candidate_dim < values.dim():
+            candidate_dim = values.dim() - 1
+
+        offsets_end = int(offsets[-1].item())
+        if offsets_end == values.shape[candidate_dim]:
+            concat_dim = candidate_dim
+        elif offsets_end == values.shape[0]:
+            # PyTorch 2.11 mis-tags Qwen mRoPE tensors whose values are laid out
+            # as [batch * 4, sequence_length].
+            concat_dim = 0
+        else:
+            raise
+
+        lengths = offsets.diff()
+        selected_tensors = [
+            values.narrow(concat_dim, int(offsets[index].item()), int(lengths[index].item()))
+            for index in indices
+        ]
+        selected_values = torch.cat(selected_tensors, dim=concat_dim)
+        selected_lengths = torch.tensor(
+            [int(lengths[index].item()) for index in indices],
+            dtype=offsets.dtype,
+            device=offsets.device,
+        )
+        selected_offsets = torch.zeros(
+            len(indices) + 1,
+            dtype=offsets.dtype,
+            device=offsets.device,
+        )
+        selected_offsets[1:] = torch.cumsum(selected_lengths, dim=0)
+        selected_tensor = torch.nested.nested_tensor_from_jagged(
+            values=selected_values,
+            offsets=selected_offsets,
+        )
+        selected_tensor._ragged_idx = ragged_idx
+        return selected_tensor
+
+    selected_tensors = [tensor_list[index] for index in indices]
+    return nested_tensor_from_tensor_list(selected_tensors, ragged_idx=ragged_idx)
 
 
