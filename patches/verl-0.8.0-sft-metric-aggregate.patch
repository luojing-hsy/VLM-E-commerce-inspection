+def _aggregate_sft_metric(value):
+    if isinstance(value, Metric):
+        return value.aggregate()
+    if isinstance(value, (list, tuple)):
+        values = [_aggregate_sft_metric(item) for item in value]
+        if values and all(isinstance(item, Number) for item in values):
+            return sum(values) / len(values)
+        return values
+    return value
